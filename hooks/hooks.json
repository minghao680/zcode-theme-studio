{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/startup.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "zcode-theme-studio background init"
          }
        ]
      }
    ]
  }
}
