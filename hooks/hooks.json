{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/watch.mjs", "--hook"],
            "timeoutMs": 15000,
            "statusMessage": "Ensuring zcode-theme-studio watcher is running"
          },
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/selfheal.mjs"],
            "timeoutMs": 120000,
            "statusMessage": "Checking zcode-theme-studio asar patch health"
          }
        ]
      }
    ]
  }
}
